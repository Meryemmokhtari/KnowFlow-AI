{
  "ReverseProxy": {
    "Routes": {
      "authRoute": {
        "ClusterId": "authCluster",
        "Match": {
          "Path": "/auth/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/auth"
          }
        ]
      },

      "userRoute": {
        "ClusterId": "userCluster",
        "Match": {
          "Path": "/users/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/users"
          }
        ]
      },

      "documentRoute": {
        "ClusterId": "documentCluster",
        "Match": {
          "Path": "/documents/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/documents"
          }
        ]
      },

      "aiRoute": {
        "ClusterId": "aiCluster",
        "Match": {
          "Path": "/ai/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/ai"
          }
        ]
      },

      "searchRoute": {
        "ClusterId": "searchCluster",
        "Match": {
          "Path": "/search/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/search"
          }
        ]
      }
    },

    "Clusters": {
      "authCluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7278/"
          }
        }
      },

      "userCluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7067/"
          }
        }
      },

      "documentCluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7288/"
          }
        }
      },

      "aiCluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7120/"
          }
        }
      },

      "searchCluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7155/"
          }
        }
      }
    }
  }
}